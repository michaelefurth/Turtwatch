# TurtWatch environment. Copy to `.env` to enable the optional Supabase cloud
# backend. When these are unset, the app runs fully local (localStorage) — the
# default prototype mode.

# Set to "supabase" to use the cloud backend; anything else / unset = local.
VITE_TURTWATCH_BACKEND=local

# From `supabase start` (local) or your project's API settings (cloud).
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Edge Function secret; never expose to the client):
# supabase secrets set OPENAI_API_KEY=sk-...
