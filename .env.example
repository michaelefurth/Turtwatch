# TurtWatch environment. Copy to `.env`. When everything is unset the app runs
# fully local (localStorage + base64 photos) — the default prototype mode.

# ---- Backend (data) ----
# "supabase" to use the cloud backend; anything else / unset = local.
VITE_TURTWATCH_BACKEND=local
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Image storage (turtle photos) ----
# local    = base64 in app state (default, no setup)
# supabase = Supabase Storage "turtles" bucket (needs the backend above)
# firebase = Firebase Storage (fill in the VITE_FIREBASE_* values below)
VITE_IMAGE_STORAGE=local

# ---- Firebase (only if VITE_IMAGE_STORAGE=firebase) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Web Push (optional; closed-app reminders & good mornings) ----
# Public VAPID key (client). Generate with: npx web-push generate-vapid-keys
# Private key + subject go to the server via `supabase secrets` (see docs/17).
VITE_VAPID_PUBLIC_KEY=

# ---- Server-side only (Edge Function secrets; never expose to the client) ----
# supabase secrets set OPENAI_API_KEY=sk-...
# supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@pond.com
